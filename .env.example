# Copy to .env for local development. `pnpm dev` loads it automatically.
# Never commit .env: it is git-ignored and secret scanning blocks credentials.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info
# LOG_FORMAT=pretty | json  (default: pretty in development, json elsewhere)

DATABASE_URL=postgres://postgres@localhost:5432/ai_workforce
TEST_DATABASE_URL=postgres://postgres@localhost:5432/ai_workforce_test

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

WEB_PORT=4000
EGRESS_PORT=4100
# Where the dashboard's server reaches the web API.
API_URL=http://localhost:4000

# Export traces to an OpenTelemetry collector (optional):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
