# Copy to .env for local development. `pnpm dev` loads it automatically.
# Never commit .env: it is git-ignored and secret scanning blocks credentials.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info
# LOG_FORMAT=pretty | json  (default: pretty in development, json elsewhere)

DATABASE_URL=postgres://postgres@localhost:5432/ai_workforce
TEST_DATABASE_URL=postgres://postgres@localhost:5432/ai_workforce_test

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

WEB_PORT=4000
# Signs session cookies. `pnpm dev` fills this with a random value on first run.
SESSION_SECRET=
# Email-only sign-in for local development. The API refuses to start with this
# enabled unless APP_ENV=local.
AUTH_DEV_LOGIN=true

# Google OAuth client (Google Cloud → Google Auth Platform → Clients, Web application).
# Redirect URI to register: http://localhost:3000/api/v1/oauth/google/callback
# Leave empty to keep Google account linking off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored refresh tokens: 32 random bytes, base64. `pnpm dev` generates it.
TOKEN_ENCRYPTION_KEY=
# Where people open the dashboard; Google redirects back here.
DASHBOARD_URL=http://localhost:3000

# Classifies messages AI employees receive (Phase 2). Leave empty to keep it off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Embeddings for the memory store (Phase 2, slice 4).
VOYAGE_API_KEY=

EGRESS_PORT=4100
# Where the dashboard's server reaches the web API.
API_URL=http://localhost:4000

# Export traces to an OpenTelemetry collector (optional):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
